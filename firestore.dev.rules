rules_version = '2';

// LOCAL EMULATOR ONLY — referenced by firebase.dev.json.
// This file must never be deployed: `firebase deploy` reads firebase.json,
// which points at firestore.rules (deny-all until authentication exists).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
