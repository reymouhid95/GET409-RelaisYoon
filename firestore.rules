rules_version = '2';

// PRODUCTION rules — read by `firebase deploy --only firestore:rules`.
// PromptLens has no authentication yet, so nobody may touch the data.
// When Firebase Auth ships, replace the deny with a per-user rule such as:
//   allow read, write: if request.auth != null
//     && request.auth.uid == resource.data.uid;
// NEVER deploy firestore.dev.rules (the emulator file) to production.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
